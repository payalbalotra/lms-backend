# --- Server ---
NODE_ENV=development
PORT=4000

# --- Postgres ---
# Format: postgres://user:password@host:port/database
DATABASE_URL=

# --- Sessions / cookies ---
# Used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# In production the cookie is __Host-session; in dev it is al-session.
COOKIE_NAME=

# --- Admin CLI guard ---
# Required to run `pnpm admin bootstrap` against an empty database.
ADMIN_BOOTSTRAP_TOKEN=

# --- Invite deep-links ---
# Public base URL used to build the activation link returned by
# POST /api/admin/employees (e.g. http://localhost:3000).
PUBLIC_WEB_BASE_URL=http://localhost:3000

# --- Cloudflare R2 (procedure image/video uploads) ---
# Account ID is visible in any R2 URL:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Create API tokens in Cloudflare -> R2 -> Manage R2 API Tokens ->
# "Create Account API token" (NOT the global Cloudflare API token page).
# Scope the token Read & Write to R2_BUCKET only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public base URL for the uploaded objects. In dev use the
# pub-xxx.r2.dev subdomain that Cloudflare hands you when you enable
# public access on the bucket. In prod swap in a custom domain like
# https://images.alimentaria.mx.
R2_PUBLIC_BASE_URL=

# Presigned PUT URL lifetime (seconds). Long enough for a 10 MB upload
# on a slow phone, short enough that a leaked URL is not long-lived.
R2_UPLOAD_TTL_SECONDS=600

# Max upload size in bytes. 10485760 = 10 MB. Mirrors the copy in the
# admin editor.
R2_UPLOAD_MAX_BYTES=10485760

# --- R2 CORS ---
# The bucket's CORS rules must allow PUT against the dev and prod origins.
# AllowedOrigins:
#   ["http://localhost:3000", "http://127.0.0.1:3000", "https://alimentaria.mx"]
# AllowedMethods: ["PUT", "GET", "HEAD"]
# AllowedHeaders: ["*"]
# ExposeHeaders: ["ETag"]
# MaxAgeSeconds: 3600
# Configure in the Cloudflare dashboard (R2 -> bucket -> Settings ->
# CORS Policy). NOT a code-side setting.